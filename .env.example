SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite+aiosqlite:///./test.db
LINKEDIN_MOCK_MODE=true
MAX_JOBS_PER_RUN=10
JOB_SOURCE=mock
# Set JOB_SOURCE=indeed and provide this token to run the Apify actor.
APIFY_API_TOKEN=
INDEED_COUNTRY=IN
INDEED_MAX_ITEMS_PER_SEARCH=10
# Total Apify listings requested by one /agent/run. Raise to 10 when ready.
INDEED_MAX_ITEMS_PER_RUN=3
# Keep one while validating costs; each extra search starts another Actor run.
INDEED_MAX_SEARCHES_PER_RUN=1
